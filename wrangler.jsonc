{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gsc-ga4-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    // Optional defaults so you don't have to name the site/property every time.
    // Fill these in after you know them (see README), then redeploy.
    "DEFAULT_GSC_SITE": "",
    "DEFAULT_GA4_PROPERTY": ""
  }
  // Secrets (NOT stored here): GOOGLE_SERVICE_ACCOUNT_JSON, ACCESS_TOKENS
  // Set them with: npx wrangler secret put <NAME>
}
